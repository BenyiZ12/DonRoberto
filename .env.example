# Variables de entorno del sitio.
# Copiá este archivo a `.env.local` (no se publica) o definí las variables
# directamente en el panel del hosting.

# Dominio definitivo del sitio. Se incorpora durante el build.
# Sin esta variable el sitio funciona igual, pero no publica URL canónica,
# no genera el sitemap con URLs absolutas y las etiquetas sociales quedan
# sin imagen. NO inventes un dominio: dejalo vacío hasta confirmarlo.
NEXT_PUBLIC_SITE_URL=

# Identificador de Google Analytics 4 (opcional).
# Solo se activa si el propietario lo autoriza. Ver docs/MANTENIMIENTO.md.
NEXT_PUBLIC_GA_ID=

# Muestra los datos de ejemplo (habitaciones y menú) marcados como "EJEMPLO".
# Útil para revisar el diseño antes de tener las fotos y los precios reales.
# En desarrollo ya está activo por defecto.
NEXT_PUBLIC_SHOW_DEMO=false
